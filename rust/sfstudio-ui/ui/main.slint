import { LineEdit, Palette, ScrollView, Button } from "std-widgets.slint";

export struct SymbolRow {
    name: string,
    path: string,
    selected: bool,
}

export struct CategoryRow {
    name: string,
    count: int,
}

component SymbolTile inherits Rectangle {
    in property <SymbolRow> symbol;
    callback choose(string);
    background: symbol.selected ? Palette.selection-background : Palette.alternate-background;
    border-radius: 12px;
    accessible-label: symbol.name;
    accessible-role: AccessibleRole.button;

    Path {
        x: (parent.width - 52px) / 2;
        y: 12px;
        width: 52px;
        height: 52px;
        commands: symbol.path;
        fill: Palette.foreground;
        fill-rule: FillRule.evenodd;
    }
    Text {
        x: 5px;
        y: 78px;
        width: parent.width - 10px;
        text: symbol.name;
        color: Palette.foreground;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        overflow: TextOverflow.elide;
    }
    TouchArea {
        clicked => { root.choose(symbol.name); }
    }
}

export component MainWindow inherits Window {
    title: "SFStudio";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1000px;
    min-height: 680px;
    background: Palette.background;

    in-out property <string> query: "";
    in-out property <string> selected-name: "0.circle.fill";
    in-out property <string> selected-path: "";
    in-out property <string> result-count: "7,007 symbols";
    in-out property <[SymbolRow]> symbols: [];
    in-out property <[CategoryRow]> categories: [];
    in-out property <int> theme-mode: 0;
    in-out property <bool> settings-screen: false;
    in-out property <float> animation-scale: 1.0;
    in-out property <float> animation-dy: 0.0;
    in-out property <float> animation-rotation: 0.0;
    in-out property <float> animation-alpha: 1.0;

    private property <int> columns: self.width < 1120px ? 4 : (self.width < 1380px ? 5 : 6);

    callback search-changed(string);
    callback category-selected(string);
    callback symbol-selected(string);
    callback theme-selected(int);
    callback settings-selected(bool);
    callback play-effect();

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 58px;
        background: Palette.background;
        Image {
            x: 16px;
            y: 14px;
            width: 28px;
            height: 28px;
            source: @image-url("../../../docs/logo.svg");
        }
        Text {
            x: 54px;
            y: 18px;
            text: "SFStudio";
            color: Palette.foreground;
            font-size: 16px;
            font-weight: 600;
        }
        LineEdit {
            x: parent.width - 280px;
            y: 10px;
            width: 260px;
            height: 36px;
            text <=> root.query;
            placeholder-text: "Search symbols";
            edited => { root.search-changed(root.query); }
        }
    }

    Rectangle {
        x: 0px;
        y: 58px;
        width: 220px;
        height: parent.height - 58px;
        background: Palette.alternate-background;
        Text { x: 12px; y: 12px; text: "LIBRARY"; color: Palette.alternate-foreground; font-size: 11px; }
        Button {
            x: 8px; y: 34px; width: 204px; height: 36px;
            text: "All Symbols";
            clicked => { root.category-selected(""); }
        }
        Button {
            x: 8px; y: 72px; width: 204px; height: 36px;
            text: "Favorites";
            enabled: false;
        }
        Text { x: 12px; y: 120px; text: "CATEGORIES"; color: Palette.alternate-foreground; font-size: 11px; }
        for category[index] in root.categories: Button {
            x: 8px;
            y: 142px + index * 34px;
            width: 204px;
            height: 32px;
            text: "\{category.name}  \{category.count}";
            clicked => { root.category-selected(category.name); }
        }
        Button {
            x: 8px; y: parent.height - 50px; width: 204px; height: 36px;
            text: root.settings-screen ? "‹  All Symbols" : "Settings  ⚙";
            clicked => { root.settings-selected(!root.settings-screen); }
        }
    }

    if !root.settings-screen: Rectangle {
        x: 220px;
        y: 58px;
        width: parent.width - 510px;
        height: parent.height - 58px;
        background: Palette.background;

        Text { x: 18px; y: 14px; text: root.result-count; color: Palette.alternate-foreground; font-size: 14px; }
        Button { x: parent.width - 314px; y: 7px; width: 136px; height: 34px; text: "Dualtone"; enabled: false; }
        Button { x: parent.width - 168px; y: 7px; width: 88px; height: 34px; text: "100%"; enabled: false; }

        ScrollView {
            x: 8px;
            y: 48px;
            width: parent.width - 16px;
            height: parent.height - 48px;
            content-width: self.width;
            content-height: ((root.symbols.length + root.columns - 1) / root.columns) * 142px + 12px;
            for symbol[index] in root.symbols: SymbolTile {
                x: 6px + Math.mod(index, root.columns) * ((parent.width - 12px - (root.columns - 1) * 10px) / root.columns + 10px);
                y: 6px + (index / root.columns) * 142px;
                width: (parent.width - 12px - (root.columns - 1) * 10px) / root.columns;
                height: 132px;
                symbol: symbol;
                choose(name) => { root.symbol-selected(name); }
            }
        }
    }

    if !root.settings-screen: Rectangle {
        x: parent.width - 290px;
        y: 58px;
        width: 290px;
        height: parent.height - 58px;
        background: Palette.alternate-background;
        Text { x: 16px; y: 12px; text: "Color   BG   Basic info"; color: Palette.foreground; font-size: 13px; }
        Rectangle {
            x: 12px; y: 48px; width: parent.width - 24px; height: 224px;
            border-radius: 12px; background: Palette.control-background;
            Path {
                x: (parent.width - 112px * root.animation-scale) / 2;
                y: (parent.height - 112px * root.animation-scale) / 2 + root.animation-dy * 80px;
                width: 112px * root.animation-scale;
                height: 112px * root.animation-scale;
                commands: root.selected-path;
                fill: Palette.foreground;
                fill-rule: FillRule.evenodd;
                opacity: root.animation-alpha;
                transform-rotation: root.animation-rotation * 1deg;
            }
        }
        Text { x: 16px; y: 282px; text: root.selected-name; color: Palette.foreground; font-size: 16px; }
        Button { x: 12px; y: 316px; width: 148px; height: 36px; text: "Effect: Bounce"; enabled: false; }
        Button { x: 168px; y: 316px; width: 106px; height: 36px; text: "Play"; clicked => { root.play-effect(); } }
        Text { x: 16px; y: 378px; text: "Appearance"; color: Palette.foreground; font-size: 14px; font-weight: 600; }
        Text { x: 16px; y: 408px; text: "Tint icon"; color: Palette.alternate-foreground; font-size: 13px; }
    }

    if root.settings-screen: Rectangle {
        x: 220px;
        y: 58px;
        width: parent.width - 220px;
        height: parent.height - 58px;
        background: Palette.background;
        Text { x: 32px; y: 24px; text: "Settings"; color: Palette.foreground; font-size: 22px; font-weight: 600; }
        Rectangle {
            x: 32px; y: 76px; width: parent.width - 64px; height: 86px;
            border-radius: 12px; background: Palette.alternate-background;
            Text { x: 18px; y: 28px; text: "Appearance"; color: Palette.foreground; font-size: 15px; }
            Button { x: parent.width - 346px; y: 25px; width: 96px; height: 36px; text: "System"; clicked => { Palette.color-scheme = ColorScheme.unknown; root.theme-selected(0); } }
            Button { x: parent.width - 244px; y: 25px; width: 96px; height: 36px; text: "Light"; clicked => { Palette.color-scheme = ColorScheme.light; root.theme-selected(1); } }
            Button { x: parent.width - 142px; y: 25px; width: 96px; height: 36px; text: "Dark"; clicked => { Palette.color-scheme = ColorScheme.dark; root.theme-selected(2); } }
        }
        Text { x: 32px; y: 188px; text: "SFStudio keeps its own catalog, search, and animation engine."; color: Palette.alternate-foreground; font-size: 14px; }
    }
}
